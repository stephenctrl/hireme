{
  "name": "hireme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A focused resume and curriculum vitae workspace with contextual AI assistance.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
