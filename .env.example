# Local-only by default. Network exposure requires a separate security review.
HOST=127.0.0.1
PORT=3001

# Optional: manual editing, PDF extraction, and PDF export work without a key.
# Keep this setting server-side; never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
